/*
 * The main sidebar of an app as agents see it: the table of contents of
 * `llms.txt` (see ../config.mts) and the check that keeps both in line
 * (./check.mts). See https://github.com/zammad/zammad-org/issues/239.
 */
import { readdirSync, readFileSync } from 'node:fs'
import { join } from 'node:path'

/** Sidebar entry as generated by `vitepress-sidebar`; links are relative to `base`. */
export interface SidebarItem {
  text?: string
  link?: string
  base?: string
  items?: SidebarItem[]
}

export type Sidebar = SidebarItem[] | Record<string, SidebarItem[] | { base?: string; items: SidebarItem[] }>

/**
 * Entries of the main sidebar (`/`). The sidebar of the user documentation
 * (`/documentation/use/`) repeats a part of it and is left out.
 */
export function mainSidebar(sidebar: Sidebar | undefined): { base: string; items: SidebarItem[] } {
  if (!sidebar) throw new Error('llms.txt: the app has no sidebar')
  if (Array.isArray(sidebar)) return { base: '/', items: sidebar }

  const main = sidebar['/']

  if (!main) throw new Error('llms.txt: the app has no main sidebar ("/")')

  return Array.isArray(main) ? { base: '/', items: main } : { base: main.base ?? '/', items: main.items }
}

/**
 * Markdown page of a link relative to the app, as `vitepress-plugin-llms`
 * writes it: `get-started/update` → `get-started/update.md`, an index page
 * `get-started/installation/` → `get-started/installation.md`.
 */
export function markdownPagePath(link: string): string {
  const path = link
    .replace(/[?#].*$/, '')
    .replace(/^\/+/, '')
    .replace(/\.(html|md)$/, '')
    .replace(/(^|\/)index$/, '')
    .replace(/\/+$/, '')

  return path === '' ? 'index.md' : `${path}.md`
}

/** Every page link of the sidebar, relative to the app, in sidebar order. */
export function sidebarLinks(items: SidebarItem[], base = '/'): string[] {
  return items.flatMap((item) => {
    const itemBase = item.base ?? base
    const own = item.link ? [joinLink(itemBase, item.link)] : []

    return [...own, ...sidebarLinks(item.items ?? [], itemBase)]
  })
}

function joinLink(base: string, link: string): string {
  return link.startsWith('/') ? link.slice(1) : `${base.replace(/^\/+/, '')}${link}`
}

/** Whether a Markdown source has content beyond its front matter. */
export function hasContent(markdown: string): boolean {
  return markdown.replace(/^---\r?\n[\s\S]*?\r?\n---[ \t]*(\r?\n|$)/, '').trim() !== ''
}

/**
 * Index pages (`foo/index.md`) below a source directory, by folder (`foo`),
 * and whether they have content. Most only carry the title and order of a
 * sidebar group in their front matter: the group has no page of its own, the
 * sidebar opens its pages. The start page of the app (`index.md`) is not
 * included.
 */
export function indexPages(sourceDir: string): Map<string, boolean> {
  const pages = new Map<string, boolean>()

  for (const file of readdirSync(sourceDir, { recursive: true, encoding: 'utf8' })) {
    const path = file.split('\\').join('/')

    if (!path.endsWith('/index.md')) continue

    pages.set(path.slice(0, -'/index.md'.length), hasContent(readFileSync(join(sourceDir, path), 'utf8')))
  }

  return pages
}

export interface TocOptions {
  /** Absolute URL of a Markdown page relative to the app (`foo/bar.md`). */
  pageUrl: (markdownPage: string) => string
  /** Whether the folder of a group (`foo`) has an index page with content, which the group then links to. */
  groupHasPage?: (folder: string) => boolean
  base?: string
}

/**
 * Table of contents of `llms.txt`: one `##` section per top-level group, its
 * entries as a list in sidebar order, nested groups as nested lists. Pages
 * link to their Markdown version. A group links to its index page only if
 * that page has content of its own.
 */
export function renderToc(items: SidebarItem[], options: TocOptions): string {
  const base = options.base ?? '/'
  const sections: string[] = []
  const loose: SidebarItem[] = []

  for (const item of items) {
    if (item.items?.length) {
      const itemBase = item.base ?? base
      const page = groupPage(item, itemBase, options)
      const overview = page ? `- [${item.text ?? ''}](${options.pageUrl(page)})\n` : ''

      sections.push(`## ${item.text ?? ''}\n\n${overview}${renderList(item.items, options, itemBase, 0)}`)
    } else if (item.link) {
      loose.push(item)
    }
  }

  // Top-level pages outside of any group, if the sidebar ever has some.
  if (loose.length) sections.unshift(`## Pages\n\n${renderList(loose, options, base, 0)}`)

  return sections.join('\n\n')
}

function renderList(items: SidebarItem[], options: TocOptions, base: string, depth: number): string {
  const indent = '  '.repeat(depth)

  return items
    .map((item) => {
      const itemBase = item.base ?? base
      const text = item.text ?? ''
      const page = item.link ? markdownPagePath(joinLink(itemBase, item.link)) : groupPage(item, itemBase, options)
      const line = page ? `${indent}- [${text}](${options.pageUrl(page)})` : `${indent}- ${text}`
      const nested = item.items?.length ? `\n${renderList(item.items, options, itemBase, depth + 1)}` : ''

      return line + nested
    })
    .join('\n')
}

/** Markdown page of a group without a link of its own, if its index page has content. */
function groupPage(item: SidebarItem, base: string, options: TocOptions): string | undefined {
  if (item.link || !item.items?.length || !options.groupHasPage) return undefined

  const folder = groupFolder(item, base)

  return folder !== undefined && options.groupHasPage(folder) ? markdownPagePath(folder) : undefined
}

/**
 * Folder of a sidebar group: the deepest folder that holds all of its pages
 * (`get-started/installation` for the pages below it).
 */
export function groupFolder(item: SidebarItem, base = '/'): string | undefined {
  const folders = sidebarLinks(item.items ?? [], item.base ?? base).map((link) =>
    markdownPagePath(link).split('/').slice(0, -1)
  )

  if (!folders.length) return undefined

  const common = folders.reduce((prefix, folder) => {
    let i = 0
    while (i < prefix.length && i < folder.length && prefix[i] === folder[i]) i++
    return prefix.slice(0, i)
  })

  return common.length ? common.join('/') : undefined
}
