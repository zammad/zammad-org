msgstr "Imposta OPZIONE a \"valore\":"

#. type: Fenced code block (sh)
#: src/en/reference/environment-variables.md:315
#, no-wrap
msgid "zammad config:set OPTION=value\n"
msgstr "zammad config:set OPTION=value\n"

#. type: Plain text
#: src/en/reference/environment-variables.md:320
msgid "Get OPTION:"
msgstr "Ottieni OPZIONE:"

#. type: Fenced code block (sh)
#: src/en/reference/environment-variables.md:321
#, no-wrap
msgid "zammad config:get OPTION\n"
msgstr "zammad config:get OPTION\n"

#. type: Plain text
#: src/en/reference/environment-variables.md:326
msgid "Unset OPTION:"
msgstr "Rimuovi OPZIONE:"

#. type: Fenced code block (sh)
#: src/en/reference/environment-variables.md:327
#, no-wrap
msgid "zammad config:unset OPTION\n"
msgstr "zammad config:unset OPTION\n"

#. type: Plain text
#: src/en/reference/environment-variables.md:332
msgid "Restart Zammad after changing settings:"
msgstr "Riavvia Zammad dopo aver modificato le impostazioni:"

#. type: Fenced code block (sh)
#: src/en/reference/environment-variables.md:333
#, no-wrap
msgid "sudo systemctl restart zammad\n"
msgstr "sudo systemctl restart zammad\n"

