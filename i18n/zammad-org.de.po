msgstr "<<< @/fixtures/rest-api/intro/get-full-search-res.json\n"

#. type: Title ####
#: src/en/reference/rest-api/intro.md:209
#, no-wrap
msgid "With Total Count Parameter"
msgstr "With Total Count Parameter"

#. type: Plain text
#: src/en/reference/rest-api/intro.md:213
msgid ""
"Using this parameter will additionally output the amount of search results.  "
"It can be combined with `full` and `expand`."
msgstr ""
"Mit diesem Parameter wird zusätzlich die Anzahl der Suchergebnisse "
"ausgegeben.  Er kann mit `full` und `expand` kombiniert werden."

#. type: Plain text
#: src/en/reference/rest-api/intro.md:215
msgid ""
"`GET`-Request sent: `/api/v1/tickets/search?"
"query=welcome&full=true&with_total_count=true`"
msgstr ""
"`GET`-Request gesendet: `/api/v1/tickets/search?"
"query=welcome&full=true&with_total_count=true`"

