msgstr "Postmaster-Filter hinzufügen, falls erforderlich"

#. type: Bullet: '- '
#: src/en/tutorials/first-steps.md:75
msgid "Configure SLAs if needed"
msgstr "Konfigurieren Sie bei Bedarf SLAs"

#. type: Bullet: '- '
#: src/en/tutorials/first-steps.md:75
msgid "Add email / social media channels & signatures"
msgstr "E-Mail-/Social-Media-Kanäle und Signaturen hinzufügen"

#. type: Bullet: '- '
#: src/en/tutorials/first-steps.md:75
msgid "Go back to group settings to add outgoing email addresses"
msgstr ""
"Gehen Sie zurück zu den Gruppeneinstellungen, um ausgehende E-Mail-Adressen "
"hinzuzufügen"

#. type: Bullet: '- '
#: src/en/tutorials/first-steps.md:75
msgid "Add Text Modules"
msgstr "Textbausteine hinzufügen"

#. type: Bullet: '- '
#: src/en/tutorials/first-steps.md:75
msgid "Add Organizations"
msgstr "Organisationen hinzufügen"

#. type: Bullet: '- '
#: src/en/tutorials/first-steps.md:75
msgid "Configure roles if needed"
msgstr "Konfigurieren Sie bei Bedarf Rollen"

#. type: Bullet: '- '
#: src/en/tutorials/first-steps.md:75
msgid "Consider third party logins or LDAP integration for easier logins"
msgstr ""
"Erwägen Sie Logins per Drittanbieter oder eine LDAP-Integration für "
"einfachere Logins"

#. type: Bullet: '- '
#: src/en/tutorials/first-steps.md:75
msgid "Add agent accounts"
msgstr "Konten für Agenten hinzufügen"

#. type: Bullet: '- '
#: src/en/tutorials/first-steps.md:75
msgid "Consider backup strategies for Zammad"
msgstr "Erwägen Sie Backup-Strategien für Zammad"

#. type: Fenced div block (tip)
#: src/en/tutorials/first-steps.md:76
#, no-wrap
