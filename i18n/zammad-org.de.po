msgstr "<<< @/fixtures/rest-api/intro/get-full-search-with-total-count-res.json\n"

#. type: Title ####
#: src/en/reference/rest-api/intro.md:220
#, no-wrap
msgid "Only Total Count Parameter"
msgstr "Only Total Count Parameter"

#. type: Plain text
#: src/en/reference/rest-api/intro.md:224
msgid ""
"Using this `only_total_count` parameter will output only the amount of "
"search results."
msgstr ""
"Mit dem Parameter `only_total_count` wird nur die Anzahl der Suchergebnisse "
"ausgegeben."

