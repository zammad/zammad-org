#. type: Bullet: '2. '
#: src/en/documentation/use/guides/knowledge-base.md:66
msgid ""
"Click the **Insert text from knowledge base answer** button in the editor "
"toolbar or type [[?]][[?]]."
msgstr ""

#. type: Bullet: '3. '
#: src/en/documentation/use/guides/knowledge-base.md:66
msgid "Search for the relevant article by title or content."
msgstr ""

#. type: Bullet: '4. '
#: src/en/documentation/use/guides/knowledge-base.md:66
