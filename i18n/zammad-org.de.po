#. type: Fenced div block (warning)
#: src/en/documentation/use/guides/knowledge-base.md:39
#, no-wrap
msgid ""
"Public answers are always visible to everyone. Internal answers require the **Knowledge Base Reader** permission.\n"
"Choose visibility carefully when publishing articles.\n"
msgstr ""

#. type: Title ##
#: src/en/documentation/use/guides/knowledge-base.md:44
#, fuzzy, no-wrap
#| msgid "Knowledge base"
msgid "Editing the knowledge base"
