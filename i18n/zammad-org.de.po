"\n"
"<<< @/fixtures/rest-api/intro/get-user-expand-false-res.json\n"
"\n"
msgstr ""
"\n"
"=== expand=true\n"
"\n"
"<<< @/fixtures/rest-api/intro/get-user-expand-true-res.json\n"
"\n"
"=== expand=false\n"
