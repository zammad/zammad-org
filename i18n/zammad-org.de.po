#~ msgid ""
#~ "Zammad requires a module (`a2enmod`) which is not enabled by default. "
#~ "CentOS users have to adjust a config file because this module is not "
#~ "available there."
#~ msgstr ""
#~ "Zammad benötigt ein Modul (`a2enmod`), das standardmäßig nicht aktiviert "
#~ "ist. Benutzer von CentOS müssen eine Konfigurationsdatei anpassen, da "
#~ "dieses Modul dort nicht verfügbar ist."

#, no-wrap
#~ msgid "a2enmod proxy proxy_html proxy_http proxy_wstunnel headers ssl\n"
