#: src/en/get-started/installation/package.md:404
#, no-wrap
msgid ""
"\n"
"| Zammad        | Elasticsearch  |\n"
"| ------------- | :------------- |\n"
"| 7.2+          | >= 8.11, <10   |\n"
"| 7.0-7.1       | >= 7.8, <10    |\n"
"| 5.2-6.5       | >= 7.8, <9     |\n"
"| 5.0-5.1       | >= 7.8, <8     |\n"
"| 4.0-4.1       | >= 6.5, <=7.12 |\n"
"| 3.4-3.6       | >= 5.5, <=7.9  |\n"
"| 3.3           | >= 2.4, <=7.6  |\n"
"| 3.2           | >= 2.4, <=7.5  |\n"
"| 3.1           | >= 2.4, <=7.4  |\n"
"| 2.0-3.0       | >= 2.4, <=5.6  |\n"
"\n"
msgstr ""
"\n"
"| Zammad        | Elasticsearch  |\n"
"| ------------- | :------------- |\n"
"| 7.2+          | >= 8.11, <10   |\n"
"| 7.0-7.1       | >= 7.8, <10    |\n"
"| 5.2-6.5       | >= 7.8, <9     |\n"
"| 5.0-5.1       | >= 7.8, <8     |\n"
"| 4.0-4.1       | >= 6.5, <=7.12 |\n"
"| 3.4-3.6       | >= 5.5, <=7.9  |\n"
"| 3.3           | >= 2.4, <=7.6  |\n"
"| 3.2           | >= 2.4, <=7.5  |\n"
"| 3.1           | >= 2.4, <=7.4  |\n"
"| 2.0-3.0       | >= 2.4, <=5.6  |\n"
