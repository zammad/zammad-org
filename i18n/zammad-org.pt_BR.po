msgstr "Código do idioma detectado."

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:636
msgid "Examples: `\"en\"`, `\"de\"`, `null`"
msgstr "Exemplos: `\"en\"`, `\"de\"`, `null`"

#. type: Title ###
#: src/en/reference/es-indexed-attributes.md:637
#, no-wrap
msgid "`detected_language_name`"
msgstr "`detected_language_name`"

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:640
msgid "Language name of detected language."
msgstr "Nome do idioma detectado."

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:642
msgid "Examples: `\"English\"`, `\"German\"`"
msgstr "Exemplos: `\"English\"`, `\"German\"`"

#. type: Title ###
#: src/en/reference/es-indexed-attributes.md:643
#: src/en/reference/es-indexed-attributes.md:1208
#, no-wrap
msgid "`from`"
msgstr "`from`"

