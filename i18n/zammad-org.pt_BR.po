msgstr "[Organizations](organization)"

#. type: Bullet: '- '
#: src/en/reference/rest-api/intro.md:167
msgid "[Roles](role)"
msgstr "[Roles](role)"

#. type: Bullet: '- '
#: src/en/reference/rest-api/intro.md:167
msgid "[Tickets](ticket)"
msgstr "[Tickets](ticket)"

#. type: Bullet: '- '
#: src/en/reference/rest-api/intro.md:167
msgid "[Users](user)"
msgstr "[Users](user)"

#. type: Plain text
#: src/en/reference/rest-api/intro.md:170
msgid ""
"The following endpoints support a search query as well, but they are not "
"explicitly covered in this documentation:"
msgstr ""
"Os seguintes endpoints também suportam uma consulta de pesquisa, mas não são "
"explicitamente cobertos nesta documentação:"

#. type: Bullet: '- '
#: src/en/reference/rest-api/intro.md:177
