#, no-wrap
msgid "Article"
msgstr "Article"

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:600
msgid ""
"Articles are part of the ticket index. To reduce complexity we decided to "
"provide it in its own section."
msgstr ""
"Os artigos fazem parte do índice do ticket. Para reduzir a complexidade, "
"decidimos fornecê-lo em sua própria seção."

#. type: Title ###
#: src/en/reference/es-indexed-attributes.md:601
#, no-wrap
msgid "`body`"
msgstr "`body`"

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:604
msgid "Article body in plaintext."
msgstr "Corpo do artigo em texto simples."

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:606
msgid ""
"Example: `\"Hi,\\n\\nplease send me:\\n1 [...] \\nThank you\\n\\nJohn Doe\"`"
msgstr ""
"Exemplo: `\"Hi,\\n\\nplease send me:\\n1 [...] \\nThank you\\n\\nJohn Doe\"`"

#. type: Title ###
#: src/en/reference/es-indexed-attributes.md:607
#, no-wrap
msgid "`cc`"
msgstr "`cc`"

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:610
msgid "The email-addresses set as CC."
msgstr "Os endereços de email definidos como CC."

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:612
msgid "Examples: `null`, `alias@domain.tld`"
msgstr "Exemplos: `null`, `alias@domain.tld`"

#. type: Title ###
#: src/en/reference/es-indexed-attributes.md:613
#: src/en/reference/rest-api/articles.md:13
#, no-wrap
msgid "`content_type`"
msgstr "`content_type`"

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:616
msgid "Content type of article."
msgstr "Tipo de conteúdo do artigo."

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:618
msgid "Examples: `\"text/html\"`, `\"text/plain\"`"
msgstr "Exemplos: `\"text/html\"`, `\"text/plain\"`"

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:622
msgid "Timestamp of article creation."
msgstr "Carimbo de data/hora da criação do artigo."

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:624
msgid "Example: `\"2025-02-22T03:47:59.290Z\"`"
msgstr "Exemplo: `\"2025-02-22T03:47:59.290Z\"`"

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:628
msgid "ID of user who created the article."
msgstr "ID do usuário que criou o artigo."

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:630
#: src/en/reference/es-indexed-attributes.md:732
msgid "Example: `10`"
msgstr "Exemplo: `10`"

#. type: Title ###
#: src/en/reference/es-indexed-attributes.md:631
#, no-wrap
msgid "`detected_language`"
msgstr "`detected_language`"

