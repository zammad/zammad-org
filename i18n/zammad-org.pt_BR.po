#: src/en/reference/es-indexed-attributes.md:694
msgid "ID of the user who sent/created the article."
msgstr "ID do usuário que enviou/criou o artigo."

#. type: Title ###
#: src/en/reference/es-indexed-attributes.md:697
#, no-wrap
msgid "`subject`"
msgstr "`subject`"

