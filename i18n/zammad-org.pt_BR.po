msgstr "<<< @/fixtures/rest-api/intro/get-full-search-with-total-count-res.json\n"

#. type: Title ####
#: src/en/reference/rest-api/intro.md:221
#, no-wrap
msgid "Only total count parameter"
msgstr "Parâmetro Only Total Count"

#. type: Plain text
#: src/en/reference/rest-api/intro.md:225
