#: src/en/reference/es-indexed-attributes.md:726
msgid "`\"2025-02-22T03:47:59.290Z\"`"
msgstr "`\"2025-02-22T03:47:59.290Z\"`"

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:730
msgid "ID of the user who updated the article."
msgstr "ID do usuário que atualizou o artigo."

