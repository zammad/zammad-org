#: src/en/reference/es-indexed-attributes.md:661
#: src/en/reference/rest-api/articles.md:78
#, no-wrap
msgid "`internal`"
msgstr "`internal`"

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:664
msgid "Defines if article is internal or not."
msgstr "Define se o artigo é interno ou não."

