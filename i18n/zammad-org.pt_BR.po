#: src/en/reference/es-indexed-attributes.md:652
msgid "Internal ID of the article."
msgstr "ID interno do artigo."

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:654
msgid "Example: `16`"
msgstr "Exemplo: `16`"

