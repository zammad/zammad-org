#: src/en/reference/es-indexed-attributes.md:714
msgid "Examples: `support@example.com`,`\"Support\"`, `null`"
msgstr "Exemplos: `support@example.com`,`\"Support\"`, `null`"

#. type: Title ###
#: src/en/reference/es-indexed-attributes.md:715
#, no-wrap
msgid "`type_id`"
msgstr "`type_id`"

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:718
msgid "ID of type of article (e.g. phone, email, web)."
msgstr "ID do tipo de artigo (por exemplo, telefone, email, web)."

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:724
msgid "Timestamp of last update of article."
msgstr "Carimbo de data/hora da última atualização do artigo."

