#: src/en/get-started/host-upgrade-repo-migration.md:6
#, no-wrap
msgid "Host upgrade and repository migration"
msgstr "Atualização de host e migração de repositório"

#. type: Plain text
#: src/en/get-started/host-upgrade-repo-migration.md:9
#: src/en/get-started/installation/package.md:9
#: src/en/get-started/installation/prerequisites.md:9
