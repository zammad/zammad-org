#: src/en/reference/es-indexed-attributes.md:648
#, no-wrap
msgid "Examples: `\"Nicole Braun <nicole.braun@zammad.org>\"`, `\"John Doe\"`\n"
msgstr "Exemplos: `\"Nicole Braun <nicole.braun@zammad.org>\"`, `\"John Doe\"`\n"

