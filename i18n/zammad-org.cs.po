#. type: Title ##
#: src/en/reference/rest-api/cti.md:246
#, no-wrap
msgid "Call answer event"
msgstr "Událost přijetí hovoru"

#. type: Plain text
#: src/en/reference/rest-api/cti.md:255
#, no-wrap
msgid ""
"`event` <Badge type=\"info\" text=\"answer\" />:\n"
":\n"
"  Tell Zammad that someone answered the call.\n"
msgstr ""
"`event` <Badge type=\"info\" text=\"answer\" />:\n"
":\n"
"  Oznámí Zammadu, že někdo hovor přijal.\n"

#. type: Plain text
#: src/en/reference/rest-api/cti.md:259 src/en/reference/rest-api/cti.md:378
#, no-wrap
msgid ""
"`from` <Badge type=\"info\" text=\"493055571600\" />:\n"
":\n"
"  Number that initiated the call.\n"
msgstr ""
"`from` <Badge type=\"info\" text=\"493055571600\" />:\n"
":\n"
"  Číslo, které hovor zahájilo.\n"

#. type: Plain text
#: src/en/reference/rest-api/cti.md:263 src/en/reference/rest-api/cti.md:382
#, no-wrap
msgid ""
"`to` <Badge type=\"info\" text=\"493055571600\" />:\n"
":\n"
"  Number that is being called.\n"
msgstr ""
"`to` <Badge type=\"info\" text=\"493055571600\" />:\n"
":\n"
"  Volané číslo.\n"

#. type: Plain text
#: src/en/reference/rest-api/cti.md:267 src/en/reference/rest-api/cti.md:386
#, no-wrap
msgid ""
"`direction` <Badge type=\"info\" text=\"in\" />:\n"
":\n"
"  The call direction - if your agent initiates a call, this will be `out`.\n"
msgstr ""
"`direction` <Badge type=\"info\" text=\"in\" />:\n"
":\n"
"  Směr hovoru – pokud hovor zahájí váš agent, bude hodnota `out`.\n"

#. type: Plain text
#: src/en/reference/rest-api/cti.md:271 src/en/reference/rest-api/cti.md:390
#, no-wrap
msgid ""
"`callId` <Badge type=\"info\" text=\"53ba82e2bd6d12d9fb2d3838f0cfb070\" />:\n"
": An ID that is unique for the call. Zammad will use this ID to identify an\n"
"  existing call with following actions (e.g. like answering or hanging up).\n"
msgstr ""
"`callId` <Badge type=\"info\" text=\"53ba82e2bd6d12d9fb2d3838f0cfb070\" />:\n"
": ID jedinečné pro daný hovor. Zammad podle tohoto ID identifikuje\n"
"  existující hovor při následných akcích (např. přijetí nebo zavěšení).\n"

#. type: Plain text
#: src/en/reference/rest-api/cti.md:278
#, no-wrap
msgid ""
"`answeringNumber` <Badge type=\"info\" text=\"493055571600\" />:\n"
":   Zammad will look up for a user with given value, the following attributes will be evaluated in given order:\n"
"      - `user.phone`\n"
"      - `user.login`\n"
"      - `user.if`\n"
"    This value is optional.\n"
msgstr ""
"`answeringNumber` <Badge type=\"info\" text=\"493055571600\" />:\n"
":   Zammad vyhledá uživatele se zadanou hodnotou; vyhodnocují se tyto atributy v uvedeném pořadí:\n"
"      - `user.phone`\n"
"      - `user.login`\n"
"      - `user.if`\n"
"    Tato hodnota je volitelná.\n"

#. type: Plain text
#: src/en/reference/rest-api/cti.md:284
#, no-wrap
msgid ""
"`user` <Badge type=\"info\" text=\"John Doe\" />:\n"
": The user(s) real name involved. You may have to provide array style (`[]`)\n"
"  params depending on the call method you choose. If the direction is `out`,\n"
"  this is the name of the calling person(s). If the direction is `in`, this is\n"
"  the name of the called person(s). This value is optional.\n"
msgstr ""
"`user` <Badge type=\"info\" text=\"John Doe\" />:\n"
": Skutečné jméno zúčastněného uživatele (uživatelů). V závislosti na zvolené metodě volání\n"
"  může být nutné předat parametry jako pole (`[]`). Pokud je směr `out`,\n"
"  jde o jméno volající osoby (osob). Pokud je směr `in`, jde o\n"
"  jméno volané osoby (osob). Tato hodnota je volitelná.\n"

