"\n"
"=== Docker Installation\n"
"\n"
"```sh\n"
"docker compose run --rm zammad-railsserver bundle exec rails r '{COMMAND}'\n"
"```\n"
"\n"
"=== Package Installation\n"
"\n"
"```sh\n"
"zammad run rails r '{COMMAND}'\n"
"\n"
"```\n"
"\n"
"=== Source / Development Installation\n"
"\n"
"```sh\n"
"rails r '{COMMAND}'\n"
"```\n"
"\n"
msgstr ""
"\n"
"=== Instalace v Dockeru\n"
"\n"
"```sh\n"
"docker compose run --rm zammad-railsserver bundle exec rails r '{COMMAND}'\n"
"```\n"
"\n"
"=== Instalace z balíčku\n"
"\n"
"```sh\n"
"zammad run rails r '{COMMAND}'\n"
"\n"
"```\n"
"\n"
"=== Instalace ze zdrojového kódu / vývojová instalace\n"
"\n"
"```sh\n"
"rails r '{COMMAND}'\n"
"```\n"
"\n"

