"Zammad allows you to define the default article type upon ticket "
"creation. By default this will be a incoming phone call."
msgstr ""

#. type: Plain text
#: src/en/reference/console.md:490
#, markdown-text
msgid "You can choose between"
msgstr ""

#. type: Bullet: '- '
#: src/en/reference/console.md:494
#, markdown-text
msgid "`phone-in` (incoming call, **default**),"
msgstr ""

#. type: Bullet: '- '
#: src/en/reference/console.md:494
#, markdown-text
msgid "`phone-out` (outgoing call) and"
msgstr ""

#. type: Bullet: '- '
#: src/en/reference/console.md:494
#, markdown-text
