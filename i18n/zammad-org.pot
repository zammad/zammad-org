"The package installation copied a ``zammad.conf`` file to your webserver "
"config directory. Check if it is present and do not rename this file!"
msgstr ""

#. type: Plain text
#: src/en/tutorials/webserver-config.md:191
#, markdown-text
msgid "Adjust your Apache config directory according to your setup:"
msgstr ""

#. type: Fenced code block (sh)
#: src/en/tutorials/webserver-config.md:192
#, no-wrap
msgid "ls /etc/apache2/sites-available\n"
msgstr ""

#. type: Title ####
#: src/en/tutorials/webserver-config.md:196
#, markdown-text, no-wrap
msgid "Step 3 - Adjust the Config File"
msgstr ""

#. type: Plain text
#: src/en/tutorials/webserver-config.md:202
#, markdown-text
msgid ""
"Locate any ``ServerName`` directive and adjust ``example.com`` to the domain "
"of your Zammad instance."
msgstr ""

#. type: Bullet: '- '
#: src/en/tutorials/webserver-config.md:209
#, markdown-text
msgid "``SSLCertificateFile`` (your ssl certificate)"
msgstr ""

#. type: Bullet: '- '
#: src/en/tutorials/webserver-config.md:209
#, markdown-text
msgid "``SSLCertificateKeyFile``(the certificates private key)"
msgstr ""

#. type: Bullet: '- '
#: src/en/tutorials/webserver-config.md:209
#, markdown-text
msgid "``SSLCertificateChainFile`` (the public CA certificate)"
