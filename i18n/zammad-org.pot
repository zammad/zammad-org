#. type: Fenced code block (ruby)
#: src/en/reference/console.md:436
#, no-wrap
msgid "Store::File.move('DB', 'File', delay_in_sec)\n"
msgstr ""

#. type: Plain text
#: src/en/reference/console.md:441
#, markdown-text
