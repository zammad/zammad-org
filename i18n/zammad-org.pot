msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/cti.md:296
#, markdown-text
msgid ""
"Depending on the chosen call direction, Zammad will return either a "
"(optionally) configured call ID or (optionally) block a caller. If your "
"Zammad hasn't configured one or both options, the return will be empty."
msgstr ""

#. type: Fenced div block (info)
#: src/en/reference/rest-api/cti.md:297
#, no-wrap
msgid "This has to be supported by your PBX in order to work.\n"
msgstr ""

#. type: Title ####
#: src/en/reference/rest-api/cti.md:301
#, markdown-text, no-wrap
msgid "Reject blocked caller IDs"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/cti.md:305
#, markdown-text
msgid ""
"If an incoming new call matches a to block number, Zammad will return the "
"following."
msgstr ""

#. type: Fenced code block (json)
#: src/en/reference/rest-api/cti.md:306
#, no-wrap
msgid ""
"{\n"
"  \"action\": \"reject\",\n"
"  \"reason\": \"busy\"\n"
"}\n"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/cti.md:314
#, markdown-text
msgid "If no to block number matches, Zammad will return the following."
msgstr ""

#. type: Fenced code block (json)
#: src/en/reference/rest-api/cti.md:315 src/en/reference/rest-api/cti.md:341
#, no-wrap
msgid "{}\n"
msgstr ""

#. type: Fenced div block (warning)
#: src/en/reference/rest-api/cti.md:319
#, no-wrap
msgid ""
"Your PBX still needs to end the call (hangup event). Other wise the\n"
"call will not just appear within Zammad's caller log but also appear as\n"
"ringing call.\n"
msgstr ""

#. type: Title ####
#: src/en/reference/rest-api/cti.md:325
#, markdown-text, no-wrap
msgid "Set specific outgoing caller ID"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/cti.md:329
#, markdown-text
msgid ""
"In case your instance has a matching overwriting caller ID configured, "
"Zammad will return the following payload."
msgstr ""

#. type: Fenced code block (json)
#: src/en/reference/rest-api/cti.md:330
#, no-wrap
msgid ""
"{\n"
"  \"action\": \"dial\",\n"
"  \"callerId\": \"493055571642\",\n"
"  \"number\": \"491711234567890\"\n"
"}\n"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/cti.md:340
#, markdown-text
msgid ""
"If no overwrite match is found or you haven't configured anything, Zammad "
"will return the following."
msgstr ""

