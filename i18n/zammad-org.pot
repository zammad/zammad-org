#: src/en/reference/rest-api/cti.md:345
#, markdown-text, no-wrap
msgid "Call Answer Event"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/cti.md:353
#, markdown-text, no-wrap
msgid ""
"`event` <Badge type=\"info\" text=\"answer\" />:\n"
": Tell Zammad that someone answered the call.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/cti.md:356 src/en/reference/rest-api/cti.md:553
#, markdown-text, no-wrap
msgid ""
"`from` <Badge type=\"info\" text=\"493055571600\" />:\n"
": Number that initiated the call.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/cti.md:359 src/en/reference/rest-api/cti.md:556
#, markdown-text, no-wrap
msgid ""
"`to` <Badge type=\"info\" text=\"493055571600\" />:\n"
": Number that is being called.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/cti.md:362 src/en/reference/rest-api/cti.md:559
#, markdown-text, no-wrap
msgid ""
"`direction` <Badge type=\"info\" text=\"in\" />:\n"
": The call direction - if your agent initiates a call, this will be `out`.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/cti.md:366 src/en/reference/rest-api/cti.md:563
#, markdown-text, no-wrap
msgid ""
"`callId` <Badge type=\"info\" text=\"53ba82e2bd6d12d9fb2d3838f0cfb070\" "
"/>:\n"
": An ID that is unique for the call. Zammad will use this ID to identify "
"an\n"
"  existing call with following actions (e.g. like answering or hanging "
"up).\n"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/cti.md:374 src/en/reference/rest-api/cti.md:583
#, markdown-text, no-wrap
msgid ""
"`answeringNumber` <Badge type=\"info\" text=\"493055571600\" />:\n"
": Zammad will look up for a user with given value, the following "
"attributes\n"
"  will be evaluated in given order:\n"
"  - `user.phone`\n"
"  - `user.login`\n"
"  - `user.if`\n"
"  This value is optional.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/cti.md:380
#, markdown-text, no-wrap
msgid ""
"`user` <Badge type=\"info\" text=\"John Doe\" />:\n"
": The user(s) real name involved. You may have to provide array style "
"(`[]`)\n"
"  params depending on the call method you choose. If the direction is "
"`out`,\n"
"  this is the name of the calling person(s). If the direction is `in`, this "
"is\n"
"  the name of the called person(s). This value is optional.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/cti.md:382
#, markdown-text
msgid "There are two options on how to `POST` the relevant data to Zammad."
msgstr ""

#. type: Fenced div block (details Show examples|tabs key:cti)
#: src/en/reference/rest-api/cti.md:385
#, no-wrap
msgid ""
"\n"
"=== JSON\n"
"\n"
"`POST`-Request sent:\n"
"`https://{FQDN-Zammad}/api/v1/cti/{instance specific token}`\n"
"\n"
"Payload:\n"
"\n"
"```json\n"
"{\n"
"   \"event\": \"answer\",\n"
"   \"from\": \"493023125741\",\n"
"   \"to\": \"492214710334\",\n"
"   \"direction\": \"out\",\n"
"   \"callId\": \"9f1840cb-8be9-4d3a-8200-3da2937085f0\",\n"
"   \"caller\": \"Lauren Brooks\"\n"
"}\n"
"```\n"
"\n"
"Response:\n"
"\n"
"```json\n"
"{}\n"
"```\n"
"\n"
"Sample curl command:\n"
"\n"
"```sh\n"
"$ curl --request POST 'https://{FQDN-Zammad}/api/v1/cti/{instance specific "
"token}' \\\n"
"   --header 'Content-Type: application/json' \\\n"
"   --data-raw '{\n"
"      \"event\": \"answer\",\n"
"      \"from\": \"493023125741\",\n"
"      \"to\": \"492214710334\",\n"
"      \"direction\": \"out\",\n"
"      \"callId\": \"9f1840cb-8be9-4d3a-8200-3da2937085f0\",\n"
"      \"caller\": \"Lauren Brooks\"\n"
"   }'\n"
"```\n"
"\n"
"=== Form-data\n"
"\n"
"`POST`-Request sent:\n"
"`https://{FQDN-Zammad}/api/v1/cti/{instance specific token}`\n"
"\n"
"Payload:\n"
"\n"
"```\n"
"event:\"answer\"\n"
"from:\"493023125741\"\n"
"to:\"492214710334\"\n"
"direction:\"out\"\n"
"callId:\"371e2cd7-67ff-4fd9-892b-030c8d128fb1\"\n"
"caller[]:\"Lauren Brooks\"\n"
"caller[]:\"Emily Tran\"\n"
"```\n"
"\n"
"Returns:\n"
"\n"
"```json\n"
"{}\n"
"```\n"
"\n"
"Sample curl command:\n"
"\n"
"```sh\n"
"$ curl --request POST 'https://{FQDN-Zammad}/api/v1/cti/{instance specific "
"token}' \\\n"
"   --form 'event=\"answer\"' \\\n"
"   --form 'from=\"493023125741\"' \\\n"
"   --form 'to=\"492214710334\"' \\\n"
"   --form 'direction=\"out\"' \\\n"
"   --form 'callId=\"371e2cd7-67ff-4fd9-892b-030c8d128fb1\"' \\\n"
"   --form 'caller[]=\"Lauren Brooks\"' \\\n"
"   --form 'caller[]=\"Emily Tran\"'\n"
"```\n"
msgstr ""

#. type: Fenced div block (details Show examples|tabs key:cti)
#: src/en/reference/rest-api/cti.md:468
#, no-wrap
msgid ""
"\n"
"=== JSON\n"
"\n"
"Payload:\n"
"\n"
"```json\n"
"{\n"
"   \"event\": \"answer\",\n"
"   \"from\": \"493023125741\",\n"
"   \"to\": \"492214710334\",\n"
"   \"direction\": \"in\",\n"
"   \"callId\": \"307fa962-de8d-4ffc-817b-7f6993204159\",\n"
"   \"answeringNumber\": \"emily@fastlane.inc\",\n"
"   \"caller\": [\"Lauren Brooks\", \"Emily Tran\"]\n"
"}\n"
"```\n"
"\n"
"Response:\n"
"\n"
"```json\n"
"{}\n"
"```\n"
"\n"
"Sample curl command:\n"
"\n"
"```sh\n"
"$ curl --request POST 'https://{FQDN-Zammad}/api/v1/cti/{instance specific "
"token}' \\\n"
"   --header 'Content-Type: application/json' \\\n"
"   --data-raw '{\n"
"      \"event\": \"answer\",\n"
