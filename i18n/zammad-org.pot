#. type: Title ###
#: src/en/reference/console.md:430
#, markdown-text, no-wrap
msgid "Enable Proxy"
msgstr ""

#. type: Plain text
#: src/en/reference/console.md:433
#, markdown-text
msgid "Set a proxy to use by Zammad:"
