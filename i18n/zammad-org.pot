msgstr ""

#. type: Title ###
#: src/en/reference/console.md:467
#, markdown-text, no-wrap
msgid "Activate Counter on Grouped Overviews"
msgstr ""

#. type: Plain text
#: src/en/reference/console.md:470
#, markdown-text
