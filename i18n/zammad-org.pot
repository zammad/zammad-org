msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/intro.md:160
#, markdown-text
msgid "Some endpoints support a search query. These are:"
msgstr ""

#. type: Bullet: '- '
#: src/en/reference/rest-api/intro.md:166
#, markdown-text
msgid "`Groups <group>`"
msgstr ""

#. type: Bullet: '- '
#: src/en/reference/rest-api/intro.md:166
#, markdown-text
msgid "`Organizations <organization>`"
msgstr ""

#. type: Bullet: '- '
#: src/en/reference/rest-api/intro.md:166
#, markdown-text
msgid "`Roles <role>`"
msgstr ""

#. type: Bullet: '- '
#: src/en/reference/rest-api/intro.md:166
#, markdown-text
msgid "`Tickets <ticket>`"
msgstr ""

#. type: Bullet: '- '
#: src/en/reference/rest-api/intro.md:166
#, markdown-text
msgid "`Users <user>`"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/intro.md:169
#, markdown-text
msgid ""
"The following endpoints support a search query as well, but they are not "
"explicitly covered in this documentation:"
msgstr ""

#. type: Bullet: '- '
#: src/en/reference/rest-api/intro.md:176
#, markdown-text
msgid "Chat Sessions"
msgstr ""

#. type: Bullet: '- '
#: src/en/reference/rest-api/intro.md:176
#, markdown-text
msgid "Knowledge base"
msgstr ""

#. type: Bullet: '- '
#: src/en/reference/rest-api/intro.md:176
#, markdown-text
msgid "Templates"
msgstr ""

#. type: Bullet: '- '
#: src/en/reference/rest-api/intro.md:176
#, markdown-text
msgid "Text module"
msgstr ""

