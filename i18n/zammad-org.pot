"\n"
"```json\n"
"# HTTP-Code 201 Created\n"
"\n"
"{\n"
"   \"id\": 11,\n"
"   \"link_type_id\": 1,\n"
"   \"link_object_source_id\": 1,\n"
"   \"link_object_source_value\": 10,\n"
"   \"link_object_target_id\": 1,\n"
"   \"link_object_target_value\": 11,\n"
"   \"created_at\": \"2023-08-08T11:46:44.108Z\",\n"
"   \"updated_at\": \"2023-08-08T11:46:44.108Z\"\n"
"}\n"
