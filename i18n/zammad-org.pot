#. type: Fenced div block (tabs key:installmethod)
#: src/en/reference/console.md:31
#, no-wrap
msgid ""
"\n"
"=== Docker Installation\n"
"\n"
"```sh\n"
"docker compose run --rm zammad-railsserver rails r '{COMMAND}'\n"
"```\n"
"\n"
"=== Package Installation\n"
"\n"
"```sh\n"
"zammad run rails r '{COMMAND}'\n"
"\n"
"```\n"
"\n"
"=== Source / Development Installation\n"
"\n"
"```sh\n"
"rails r '{COMMAND}'\n"
"```\n"
"\n"
msgstr ""

#. type: Title ###
#: src/en/reference/console.md:54
#, markdown-text, no-wrap
msgid "Run Interactive Rails Console"
msgstr ""

#. type: Fenced div block (tabs key:installmethod)
#: src/en/reference/console.md:56
#, no-wrap
msgid ""
"\n"
"=== Docker Installation\n"
"\n"
"```sh\n"
"docker compose run --rm zammad-railsserver rails c\n"
"```\n"
"\n"
"=== Package Installation\n"
"\n"
"```sh\n"
"zammad run rails c\n"
"\n"
"```\n"
"\n"
"=== Source / Development Installation\n"
"\n"
"```sh\n"
"rails c\n"
"```\n"
"\n"
