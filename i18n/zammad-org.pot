#. type: Bullet: '- '
#: src/en/reference/rest-api/cti.md:87
#, markdown-text
msgid "Default caller ID for outbound calls `496990009111`"
msgstr ""

#. type: Title ##
#: src/en/reference/rest-api/cti.md:88
#, markdown-text, no-wrap
msgid "New Call Event"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/cti.md:93 src/en/reference/rest-api/cti.md:246
#, markdown-text, no-wrap
msgid "Available `attributes` and <Badge type=\"info\" text=\"sample data\" />:\n"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/cti.md:96
#, markdown-text, no-wrap
msgid ""
"`event` <Badge type=\"info\" text=\"newCall\"/>\n"
": Tell Zammad there is a new call.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/cti.md:99
#, markdown-text, no-wrap
msgid ""
"`from` <Badge type=\"info\" text=\"4930555716000\"/>\n"
": Number that initiated the call. Can be `anonymous` as well.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/cti.md:102
#, markdown-text, no-wrap
msgid ""
"`to` <Badge type=\"info\" text=\"4930555716000\"/>\n"
": Number that is being called.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/cti.md:106
#, markdown-text, no-wrap
msgid ""
"`direction` <Badge type=\"info\" text=\"in\"/>\n"
": The call direction. If your agent initiates a call, this will be "
"`out`. Calls\n"
"from external side to you are `in`.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/cti.md:110
#, markdown-text, no-wrap
msgid ""
"`callId` <Badge type=\"info\" text=\"53ba82e2bd6d12d9fb2d3838f0cfb070\"/>\n"
": An ID that is unique for the call. Zammad will use this ID to identify "
"an\n"
"  existing call with following actions (e.g. like answering or hanging "
"up).\n"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/cti.md:116
#, markdown-text, no-wrap
msgid ""
"`user` <Badge type=\"info\" text=\"John Doe\"/>\n"
": The user(s) real name involved. You may have to provide array style "
"(`[]`)\n"
"  params depending on the call method you choose. If the direction is "
"`out`,\n"
"  this is the name of the calling person(s). If the direction is `in`, "
"this\n"
"  is the name of the called person(s).\n"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/cti.md:121
#, markdown-text, no-wrap
msgid ""
"`queue` <Badge type=\"info\" text=\"support\"/>\n"
": An optional queue name, this option is relevant for the caller log "
"filter.\n"
"  This value is optional.\n"
msgstr ""

#. type: Fenced div block (details Show examples|tabs key:cti)
#: src/en/reference/rest-api/cti.md:124
#, no-wrap
msgid ""
"\n"
"=== JSON\n"
