msgstr ""

#. type: Bullet: '- '
#: src/en/documentation/use/advanced-features.md:158
#, markdown-text
msgid "Edit the current checklist:"
msgstr ""

#. type: Bullet: '  - '
#: src/en/documentation/use/advanced-features.md:158
#, markdown-text
msgid ""
"Rename it by clicking on the title or using the ::a:: menu in the sidebar "
"header."
msgstr ""

#. type: Bullet: '  - '
