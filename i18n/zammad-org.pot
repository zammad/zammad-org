#, no-wrap
msgid "<<< @/fixtures/rest-api/intro/get-full-search-res.json\n"
msgstr ""

#. type: Title ####
#: src/en/reference/rest-api/intro.md:209
#, markdown-text, no-wrap
msgid "With Total Count Parameter"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/intro.md:213
#, markdown-text
msgid ""
"Using this parameter will additionally output the amount of search results.  "
"It can be combined with `full` and `expand`."
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/intro.md:215
#, markdown-text
