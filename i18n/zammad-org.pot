#. type: Fenced code block (ruby)
#: src/en/reference/console.md:433
#, no-wrap
msgid ""
"Setting.set('es_attachment_ignore', %w[.png .jpg .jpeg .mpeg .mpg .mov .bin "
".exe .box .mbox])\n"
msgstr ""

#. type: Plain text
#: src/en/reference/console.md:437
#, markdown-text
msgid "Limit the attachment size:"
msgstr ""

#. type: Fenced code block (ruby)
#: src/en/reference/console.md:437
#, no-wrap
msgid "Setting.set('es_attachment_max_size_in_mb', 50)\n"
msgstr ""

#. type: Plain text
#: src/en/reference/console.md:441
#, markdown-text
msgid "Turn SSL verification on or off:"
msgstr ""

#. type: Fenced code block (ruby)
#: src/en/reference/console.md:441
#, no-wrap
msgid "Setting.set('es_ssl_verify', 'false')\n"
msgstr ""

#. type: Title ###
#: src/en/reference/console.md:445
#, markdown-text, no-wrap
msgid "Enable Proxy"
msgstr ""

#. type: Plain text
#: src/en/reference/console.md:448
#, markdown-text
msgid "Set a proxy to use by Zammad:"
