#. type: Fenced code block (ruby)
#: src/en/reference/console.md:406
#, no-wrap
msgid "Setting.set('es_user', 'elasticsearch')\n"
msgstr ""

#. type: Plain text
#: src/en/reference/console.md:410
#, markdown-text
msgid "Change the elasticsearch password for authentication:"
msgstr ""

#. type: Fenced code block (ruby)
#: src/en/reference/console.md:410
#, no-wrap
msgid "Setting.set('es_password', 'zammad')\n"
msgstr ""

#. type: Plain text
#: src/en/reference/console.md:414
#, markdown-text
msgid "Change the index name:"
msgstr ""

#. type: Fenced code block (ruby)
#: src/en/reference/console.md:414
#, no-wrap
msgid "Setting.set('es_index', Socket.gethostname + '_zammad')\n"
msgstr ""

#. type: Plain text
#: src/en/reference/console.md:418
#, markdown-text
msgid "Ignore files by file extension from being indexed:"
