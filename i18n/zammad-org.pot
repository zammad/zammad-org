#: src/en/get-started/installation/package.md:166
#, markdown-text, no-wrap
msgid "Add Zammad Repository"
msgstr ""

#. type: Fenced div block (info)
#: src/en/get-started/installation/package.md:168
#, no-wrap
msgid ""
"Packager.io may not be accessible from IPv6-only environments, so make "
"sure\n"
"to consider this when performing the steps below.\n"
msgstr ""

#. type: Plain text
#: src/en/get-started/installation/package.md:174
#, markdown-text, no-wrap
msgid ""
"<!-- repo instructions included in host-upgrade.md; referenced with line "
"numbers 171-283. Make sure to keep it or\n"
"adjust it over there -->\n"
msgstr ""

#. type: Fenced div block (tabs key:distros)
#: src/en/get-started/installation/package.md:174
#, no-wrap
msgid ""
"\n"
"=== Ubuntu\n"
"Install repository key:\n"
"\n"
"```sh\n"
"sudo curl -fsSL \"https://go.packager.io/srv/deb/zammad/zammad/gpg-key.gpg\" "
"\\\n"
"  -o /usr/share/keyrings/zammad.gpg && sudo chmod 644 "
"/usr/share/keyrings/zammad.gpg\n"
"```\n"
"\n"
"Add repository (Ubuntu 22.04):\n"
"\n"
"```sh\n"
"sudo curl -fsSL "
"\"https://go.packager.io/srv/zammad/zammad/stable/installer/ubuntu/22.04.list\" "
"\\\n"
"  -o /etc/apt/sources.list.d/zammad.list\n"
"```\n"
"\n"
"Add repository (Ubuntu 24.04):\n"
"\n"
"```sh\n"
"sudo curl -fsSL "
"\"https://go.packager.io/srv/zammad/zammad/stable/installer/ubuntu/24.04.list\" "
"\\\n"
"  -o /etc/apt/sources.list.d/zammad.list\n"
"```\n"
"\n"
"=== Debian\n"
"\n"
"Install repository key:\n"
"\n"
"```sh\n"
"sudo curl -fsSL \"https://go.packager.io/srv/deb/zammad/zammad/gpg-key.gpg\" "
"\\\n"
"  -o /usr/share/keyrings/zammad.gpg && sudo chmod 644 "
"/usr/share/keyrings/zammad.gpg\n"
"```\n"
"\n"
"Add repository (Debian 11):\n"
"\n"
"```sh\n"
"sudo curl -fsSL "
"\"https://go.packager.io/srv/zammad/zammad/stable/installer/debian/11.list\" "
"\\\n"
"  -o /etc/apt/sources.list.d/zammad.list\n"
"```\n"
"\n"
"Add repository (Debian 12):\n"
"\n"
"```sh\n"
"sudo curl -fsSL "
"\"https://go.packager.io/srv/zammad/zammad/stable/installer/debian/12.list\" "
"\\\n"
"  -o /etc/apt/sources.list.d/zammad.list\n"
"```\n"
"\n"
"Add repository (Debian 13):\n"
"\n"
"```sh\n"
"sudo curl -fsSL "
"\"https://go.packager.io/srv/zammad/zammad/stable/installer/debian/13.list\" "
"\\\n"
"  -o /etc/apt/sources.list.d/zammad.list\n"
"```\n"
"\n"
"=== OpenSUSE/SLES\n"
"\n"
"Add repository:\n"
"\n"
"```sh\n"
"sudo curl -o /etc/zypp/repos.d/zammad.repo \\\n"
"  "
"\"https://go.packager.io/srv/zammad/zammad/stable/installer/sles/15.repo\"\n"
"```\n"
"\n"
"===CentOS/RHEL\n"
"Add repository key:\n"
"\n"
"```sh\n"
"sudo rpm --import https://go.packager.io/srv/rpm/zammad/zammad/gpg-key.asc\n"
"```\n"
"\n"
"Add repository:\n"
"\n"
"```sh\n"
"sudo curl -fsSL "
"\"https://go.packager.io/srv/zammad/zammad/stable/installer/el/9.repo\" \\\n"
"  -o /etc/yum.repos.d/zammad.repo\n"
"```\n"
"\n"
msgstr ""

