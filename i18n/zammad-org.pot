#. type: Title #
#: src/en/reference/docker-env-vars.md:1 src/en/reference/docker-env-vars.md:6
#, markdown-text, no-wrap
msgid "Docker Environment Variables"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:10
#, markdown-text
msgid ""
"Find the available docker environment variables below with default values, "
"if applicable. You might also be interested in the [environment variables "
"documentation](/en/reference/env-vars)."
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:17
#, markdown-text, no-wrap
msgid ""
"`VERSION` <Badge type=\"info\" text=\"<current stable version of "
"Zammad>\"/>\n"
": Allows customization of the Zammad image tag. Example: `6.3.1-54`.\n"
"  This default version may be increased when you update your Zammad docker\n"
"  stack. Please see the example env template for more details on this "
"variable.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:22
#, markdown-text, no-wrap
msgid ""
"`AUTOWIZARD_JSON`\n"
": This variable allows you to provide initial configuration data for your\n"
"  instance. Autowizard JSON is out of scope of this documentation, however "
"this\n"
"  example file should help.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:26
#, markdown-text, no-wrap
msgid ""
"`ZAMMAD_WEB_CONCURRENCY`\n"
": Allows spawning `n` workers to allow more simultaneous connections for\n"
"  Zammad's  web UI.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:30
#, markdown-text, no-wrap
msgid ""
"`ZAMMAD_SESSION_JOBS_CONCURRENT`\n"
": Allows spawning `n` session job workers to release pressure from "
"Zammad's\n"
"  background worker.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:34
#, markdown-text, no-wrap
msgid ""
"`ZAMMAD_PROCESS_SCHEDULED_JOBS_WORKERS`\n"
": Allows spawning `1` independent scheduled job worker to reduce pressure\n"
"  from Zammad's background worker.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:38
#, markdown-text, no-wrap
msgid ""
"`ZAMMAD_PROCESS_DELAYED_JOBS_WORKERS`\n"
": Allows spawning n delayed job workers to reduce pressure from Zammad's\n"
"  background worker.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:41
#, markdown-text, no-wrap
msgid ""
"`RAILS_TRUSTED_PROXIES` <Badge type=\"info\" text=\"['127.0.0.1', "
"'::1']\"/>\n"
": By default Zammad trusts localhost proxies only.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:44
#, markdown-text, no-wrap
msgid ""
"`MEMCACHE_SERVERS` <Badge type=\"info\" text=\"zammad-memcached:11211\"/>\n"
": Provide your own Memcached instance to Zammad if you already have one.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:48
#, markdown-text, no-wrap
msgid ""
"`REDIS_URL` <Badge type=\"info\" text=\"redis://zammad-redis:6379\"/>\n"
": Provide your own Redis instance if you already have one. Please note "
"that\n"
"this method currently does not allow authentication.\n"
msgstr ""

#. type: Title ##
#: src/en/reference/docker-env-vars.md:49
#, markdown-text, no-wrap
msgid "Elasticsearch"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:54
#, markdown-text, no-wrap
msgid ""
"`ELASTICSEARCH_ENABLED` <Badge type=\"info\" text=\"true\"/>\n"
": Setting this variable to false will allow you to run your Zammad without\n"
"Elasticsearch. Please note that we strongly advise against doing so.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:57
#, markdown-text, no-wrap
msgid ""
"`ELASTICSEARCH_HOST` <Badge type=\"info\" text=\"zammad-elasticsearch\"/>\n"
": Provide a host name or address to your external Elasticsearch cluster.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:60
#, markdown-text, no-wrap
msgid ""
"`ELASTICSEARCH_PORT` <Badge type=\"info\" text=\"9200\"/>\n"
": Provide a different port for Elasticsearch if needed.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:63
#, markdown-text, no-wrap
msgid ""
"`ELASTICSEARCH_SCHEMA` <Badge type=\"info\" text=\"http\"/>\n"
": By default, Elasticsearch is reachable via HTTP.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:67
#, markdown-text, no-wrap
msgid ""
"`ELASTICSEARCH_NAMESPACE` <Badge type=\"info\" text=\"zammad\"/>\n"
": With this name space all Zammad related indexes will be created. Change "
"this\n"
"  if you're using external clusters.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:71
#, markdown-text, no-wrap
msgid ""
"`ELASTICSEARCH_REINDEX` <Badge type=\"info\" text=\"true\"/>\n"
": By default the docker-compose will always re-index upon a restart. On "
"big\n"
"  installations, this may be troublesome.\n"
msgstr ""

#. type: Fenced div block (warning)
#: src/en/reference/docker-env-vars.md:71
#, no-wrap
msgid ""
"  Disabling this setting requires you to re-index your search index "
"manually\n"
"  whenever you upgrade to a new Zammad version!\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:79
#, markdown-text, no-wrap
msgid ""
"`ELASTICSEARCH_SSL_VERIFY` <Badge type=\"info\" text=\"true\"/>\n"
": Allows you to let the compose scripts ignore self signed SSL "
"certificates\n"
"  for your Elasticsearch installation if needed.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:84
#, markdown-text, no-wrap
msgid ""
"`POSTGRESQL_HOST` <Badge type=\"info\" text=\"zammad-postgresql\"/>\n"
": Host name of your PostgreSQL server. Use your own if you already have "
"one.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:87
#, markdown-text, no-wrap
msgid ""
"`POSTGRESQL_PORT` <Badge type=\"info\" text=\"5432\"/>\n"
": Adjust the Port of your PostgreSQL server.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:90
#, markdown-text, no-wrap
msgid ""
"`POSTGRESQL_USER` <Badge type=\"info\" text=\"zammad\"/>\n"
": The database user for Zammad.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:93
#, markdown-text, no-wrap
msgid ""
"`POSTGRESQL_PASS` <Badge type=\"info\" text=\"zammad\"/>\n"
": The password of Zammads database user.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:96
#, markdown-text, no-wrap
msgid ""
"`POSTGRESQL_DB` <Badge type=\"info\" text=\"zammad_production\"/>\n"
": Zammads database to use.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:99
#, markdown-text, no-wrap
msgid ""
"`POSTGRESQL_OPTIONS` <Badge type=\"info\" text=\"?pool=50\"/>\n"
": Additional postgresql parameters to be appended to the database URI.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:102
#, markdown-text, no-wrap
msgid ""
"`POSTGRESQL_DB_CREATE` <Badge type=\"info\" text=\"true\"/>\n"
": By default Zammad creates the required database.\n"
msgstr ""

#. type: Fenced div block (warning)
#: src/en/reference/docker-env-vars.md:102
#, no-wrap
msgid "  On dedicated database servers, this setting might be troublesome.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:112
#, markdown-text, no-wrap
msgid ""
"`NGINX_EXPOSE_PORT` <Badge type=\"info\" text=\"8080\"/>\n"
": The port to be exposed for accessing the Zammad stack from "
"outside. Change\n"
"  this to another value if you already have an existing service listening "
"on\n"
"  this port.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:115
#, markdown-text, no-wrap
msgid ""
"`NGINX_PORT` <Badge type=\"info\" text=\"8080\"/>\n"
": The internal port the nginx service will listen on.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:119
#, markdown-text, no-wrap
msgid ""
"`NGINX_SERVER_NAME` <Badge type=\"info\" text=\"_\"/>\n"
": By default the Nginx container of Zammad will respond to all "
"request. You\n"
"  can provide your IP / FQDN if you want to.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:124
#, markdown-text, no-wrap
msgid ""
"`NGINX_SERVER_SCHEME` <Badge type=\"info\" text=\"\\$scheme\"/>\n"
": If the Nginx container for Zammad is not the upstream server (means if "
"you\n"
"  are using another proxy in front of nginx) you might want to change "
"this.\n"
"  You can set the correct scheme `http` or `https` if needed.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:127
#, markdown-text, no-wrap
msgid ""
"`ZAMMAD_RAILSSERVER_HOST` <Badge type=\"info\" "
"text=\"zammad-railsserver\"/>\n"
": Host name of the rails server container.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:130
#, markdown-text, no-wrap
msgid ""
"`ZAMMAD_RAILSSERVER_PORT` <Badge type=\"info\" text=\"3000\"/>\n"
": Port of Zammads rails server.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:133
#, markdown-text, no-wrap
msgid ""
"`ZAMMAD_WEBSOCKET_HOST` <Badge type=\"info\" text=\"zammad-websocket\"/>\n"
": Host name of Zammads websocket server.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/docker-env-vars.md:135
#, markdown-text, no-wrap
msgid ""
"`ZAMMAD_WEBSOCKET_PORT` <Badge type=\"info\" text=\"6042\"/>\n"
": Port of Zammad's websocket server.\n"
msgstr ""

#. type: Title #
#: src/en/reference/env-vars.md:1 src/en/reference/env-vars.md:6
#, markdown-text, no-wrap
msgid "Environment Variables"
msgstr ""

#. type: Title #
#: src/en/reference/es-indexed-attributes.md:1
#: src/en/reference/es-indexed-attributes.md:6
#, markdown-text, no-wrap
msgid "Elasticsearch Indexed Attributes"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:12
#, markdown-text
msgid ""
"You can find a comprehensive list of all default object attributes indexed "
"by Elasticsearch below. In other words, if you wish to find a ticket, "
"article, or user via the Zammad search box, Elasticsearch can match on any "
"(or all) of the fields below."
msgstr ""

#. type: Fenced div block (info)
#: src/en/reference/es-indexed-attributes.md:13
#, no-wrap
msgid ""
"\n"
"- <Badge type=\"info\" text=\"SLA\"/>: Attributes marked as SLA are only set "
"if\n"
"  the ticket is affected by SLA calculation. Please note that some "
"attributes\n"
"  may not be set if specific conditions are not met.\n"
"- Also note that some attributes may be reset to `null` if no longer "
"applicable.\n"
"- `note` attribute: Note attributes usually are empty if not specified via "
"console or API.\n"
"- Timestamps: All timestamps provided by Zammad are UTC by default. This "
"also\n"
"  applies to times provided by Elasticsearch\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:25
#, markdown-text
msgid ""
"The attributes, example values and description below are constructed like "
"that:"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:29
#, markdown-text, no-wrap
msgid ""
"`attribute`\n"
": - `1`, `null`\n"
"  - This is the description of the attribute, if available.\n"
msgstr ""

#. type: Title #
#: src/en/reference/es-indexed-attributes.md:30
#: src/en/reference/rest-api/ticket.md:1 src/en/reference/rest-api/ticket.md:6
#, markdown-text, no-wrap
msgid "Ticket"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:33
#: src/en/reference/es-indexed-attributes.md:396
#, markdown-text
msgid "The following index contains below mentioned information: `*_ticket`"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:37
#, markdown-text, no-wrap
msgid ""
"`article`\n"
": - Array with all articles belonging to the ticket\n"
"  - See [article section ](#article) for more details.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:41
#, markdown-text, no-wrap
msgid ""
"`article_count`\n"
": - `1`\n"
"  - Number of articles within the ticket\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:47
#, markdown-text, no-wrap
msgid ""
"`checklist`\n"
": - Contains these attributes:\n"
"    - name: `null`, `Checklist title`;\n"
"    - items: `(array)`\n"
"  - Items array contains the text of the items\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:51
#, markdown-text, no-wrap
msgid ""
"`close_at`\n"
": - `null`, `2021-03-03T14:50:20.673Z`\n"
"  - First close time, set once\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:56
#, markdown-text, no-wrap
msgid ""
"`close_diff_in_min` <Badge type=\"info\" text=\"SLA\"/>\n"
": - `null`, `239`, `-5`\n"
"  - Depends on close_in_min and tells how many minutes the ticket was "
"closed\n"
"    relative to SLAs solution time.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:60
#, markdown-text, no-wrap
msgid ""
"`close_escalation_at` <Badge type=\"info\" text=\"SLA\"/>\n"
": - `null`, `2021-03-03T15:50:20.673Z`\n"
"  - Time stamp when the ticket would escalate in case solution time is "
"violated.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:64
#, markdown-text, no-wrap
msgid ""
"`close_in_min` <Badge type=\"info\" text=\"SLA\"/>\n"
": - `null`, `11`\n"
"  - Value in minutes for how long the ticket was open based on business "
"hours.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:75
#, markdown-text, no-wrap
msgid ""
"`create_article_sender`\n"
": - Contains these attributes:\n"
"      - note: `null`\n"
"      - updated_at: `2021-03-03T14:50:20.812Z`\n"
"      - name: `Customer`\n"
"      - created_at: `2021-03-03T14:50:20.812Z`\n"
"      - updated_by_id: `1`\n"
"      - id: `2`\n"
"      - created_by_id: `1`\n"
"  - Sender of the article (System, Agent, Customer)\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:79
#, markdown-text, no-wrap
msgid ""
"`create_article_sender_id`\n"
": - `1`, `2`\n"
"  - ID of the user that created the article.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:92
#, markdown-text, no-wrap
msgid ""
"`create_article_type`\n"
": - Contains these attributes:\n"
"    - note: `null`\n"
"    - updated_at: `2021-03-03T14:50:20.812Z`\n"
"    - name: `phone`, `email`, `web`\n"
"    - active: `true`\n"
"    - created_at: `2021-03-03T14:50:20.812Z`\n"
"    - updated_by_id: `1`\n"
"    - id: `5`\n"
"    - created_by_id: `1`\n"
"    - communication: `true`, `false`\n"
"    - Information of first article type and nature\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:96
#, markdown-text, no-wrap
msgid ""
"`create_article_type_id`\n"
": - `5`\n"
"  - Type ID of first article\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:100
#, markdown-text, no-wrap
msgid ""
"`created_at`\n"
": - `2021-03-24T16:17:27.210Z`\n"
"  - Time stamp of ticket creation\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:105
#, markdown-text, no-wrap
msgid ""
"`created_by`\n"
": - \\#\\{user object\\}\n"
"  - Complete Payload of user that created the ticket. Have a look at the\n"
"    [user section](#user) for more information.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:109
#, markdown-text, no-wrap
msgid ""
"`created_by_id`\n"
": - `3`\n"
"  - User ID that created the ticket.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:114
#, markdown-text, no-wrap
msgid ""
"`customer`\n"
": - \\#\\{user object\\}\n"
"  - Complete payload of the customer that created the ticket. Have a look at "
"the\n"
"    [user section](#user) for more information.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:118
#, markdown-text, no-wrap
msgid ""
"`customer_id`\n"
": - `8`\n"
"  - Customers User ID\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:126
#, markdown-text, no-wrap
msgid ""
"`escalation_at` <Badge type=\"info\" text=\"SLA\"/>\n"
": - `null`, `2021-03-24T16:28:38.535Z`\n"
"  - Time stamp of the next applicable escalation. One of the following\n"
"    attributes:\n"
"      - `close_escalation_at`\n"
"      - `first_response_escalation_at`\n"
"      - `update_escalation_at`\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:130
#, markdown-text, no-wrap
msgid ""
"`first_response_at` <Badge type=\"info\" text=\"SLA\"/>\n"
": - `null`, `2021-03-24T16:28:38.303Z`\n"
"  - Time stamp of the first communication type reaction to the customer.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:135
#, markdown-text, no-wrap
msgid ""
"`first_response_diff_in_min` <Badge type=\"info\" text=\"SLA\"/>\n"
": - `null`, `10`, `-6`\n"
"  - Depends on `first_response_in_min` and tells how many minutes the "
"tickets\n"
"    first response took relative to the first response time of your SLA.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:140
#, markdown-text, no-wrap
msgid ""
"`first_response_in_min` <Badge type=\"info\" text=\"SLA\"/>\n"
": - `null`, `11`\n"
"  - Value in minutes for how long the first response took based on the\n"
"    business hours.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:145
#, markdown-text, no-wrap
msgid ""
"`group`\n"
": - \\#\\{group object\\}\n"
"  - Complete payload of the current tickets group. Have a look at the\n"
"    [group section](#group) for more information.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:149
#, markdown-text, no-wrap
msgid ""
"`group_id`\n"
": - `1`\n"
"  - ID of the current group\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:153
#, markdown-text, no-wrap
msgid ""
"`id`\n"
"- : `1`, `111`\n"
"  - ID of the Ticket\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:157
#, markdown-text, no-wrap
msgid ""
"`last_close_at`\n"
": - `null`, `2021-03-03T14:50:20.673Z`\n"
"  - Last close time, set on each closing of ticket.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:161
#, markdown-text, no-wrap
msgid ""
"`last_contact_agent_at`\n"
": - `null`, `2021-03-24T16:28:38.303Z`\n"
"  - Time stamp of last communication type contact of any agent.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:167
#, markdown-text, no-wrap
msgid ""
"`last_contact_at`\n"
": - `null`, `2021-03-24T16:28:38.303Z`\n"
"  - Time stamp of last communication type contact. Depends on\n"
"    `last_contact_agent_at`, `last_contact_customer_at` and\n"
"    “Ticket Last Contact Behavior” setting.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:171
#, markdown-text, no-wrap
msgid ""
"`last_contact_customer_at`\n"
": - `null`, `2021-03-24T16:28:38.303Z`\n"
"  - Time stamp of last communication type contact of customer.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:175
#, markdown-text, no-wrap
msgid ""
"`mention_user_ids`\n"
": - `[3, 5]`\n"
"  - Array with mentioned or subscribed users IDs.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:179
#, markdown-text, no-wrap
msgid ""
"`note`\n"
": - `null`\n"
"  - Note of ticket, only set via console or API.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:183
#, markdown-text, no-wrap
msgid ""
"`number`\n"
": - `1010138`, `202006231010138`\n"
"  - Ticket number\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:188
#, markdown-text, no-wrap
msgid ""
"`organization`\n"
": - `null`, \\#\\{organization object\\}\n"
"  - Complete payload of user that owns the ticket. Have a look at the\n"
"    [organization section](#organization) for more information.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/es-indexed-attributes.md:192
