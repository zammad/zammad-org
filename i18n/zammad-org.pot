"\n"
"```sh\n"
"docker compose run --rm zammad-railsserver bundle exec rails c\n"
"```\n"
"\n"
"=== Package Installation\n"
"\n"
"```sh\n"
"zammad run rails c\n"
"\n"
"```\n"
"\n"
"=== Source / Development Installation\n"
"\n"
"```sh\n"
"rails c\n"
"```\n"
"\n"
