#. type: Title ##
#: src/en/reference/rest-api/cti.md:359
#, markdown-text, no-wrap
msgid "Call Hangup"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/cti.md:365
#, markdown-text, no-wrap
msgid ""
"`event` <Badge type=\"info\" text=\"hangup\" />:\n"
": Tell Zammad that someone answered the call.\n"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/cti.md:389
#, markdown-text, no-wrap
msgid ""
"`cause`\n"
":   This defines the reason of the hangup. Zammad evaluates the cause and "
"indicates\n"
"    e.g. missed calls accordingly in the caller log. Possible values are:\n"
"    - `normalClearing` (one of the parties hung up after the call was "
"established)\n"
"    - `busy` (the called party was busy)\n"
"    - `cancel` (the caller hung up before the called party picked up)\n"
"    - `noAnswer` (the called party rejected the call. E.g. through a DND "
"setting)\n"
"    - `congestion` (the called party could not be reached)\n"
"    - `notFound` (the called number does not exist or called party is "
"offline)\n"
"    - `forwarded` (the call was forwarded to a different party)\n"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/cti.md:396
#, markdown-text, no-wrap
msgid ""
"`answeringNumber` <Badge type=\"info\" text=\"493055571600\" />:\n"
":   Zammad will look up for a user with given value, the following "
"attributes will be evaluated in given order:\n"
"    - `user.phone`\n"
"    - `user.login`\n"
"    - `user.if`\n"
"    This value is optional.\n"
msgstr ""

