#. type: Plain text
#: src/en/reference/console.md:449
#, markdown-text
msgid ""
"If your Elasticsearch installation changes, you can use the following "
"commands to ensure that Zammad still can access Elasticsearch."
msgstr ""

#. type: Plain text
#: src/en/reference/console.md:451
#, markdown-text
msgid "Change elasticsearch URL:"
msgstr ""

#. type: Fenced code block (ruby)
#: src/en/reference/console.md:452
#, no-wrap
msgid "Setting.set('es_url', 'http://127.0.0.1:9200')\n"
msgstr ""

#. type: Plain text
#: src/en/reference/console.md:457
#, markdown-text
msgid "Change elasticsearch user (e.g. for authentication):"
msgstr ""

#. type: Fenced code block (ruby)
#: src/en/reference/console.md:458
#, no-wrap
msgid "Setting.set('es_user', 'elasticsearch')\n"
msgstr ""

#. type: Plain text
#: src/en/reference/console.md:463
#, markdown-text
msgid "Change the elasticsearch password for authentication:"
msgstr ""

#. type: Fenced code block (ruby)
#: src/en/reference/console.md:464
#, no-wrap
msgid "Setting.set('es_password', 'zammad')\n"
msgstr ""

#. type: Plain text
#: src/en/reference/console.md:469
#, markdown-text
msgid "Change the index name:"
