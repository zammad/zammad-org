"\n"

#. type: Plain text
#: src/en/reference/rest-api/intro.md:116
#, no-wrap
msgid "**Ticket payload:**\n"
msgstr "**Payload тикета:**\n"

#. type: Fenced div block (details|tabs)
#: src/en/reference/rest-api/intro.md:117
#, no-wrap
msgid ""
"\n"
"=== expand=true\n"
