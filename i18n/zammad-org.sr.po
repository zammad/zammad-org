msgid "Signing & Encryption"
msgstr "Потписивање и шифровање"

#. type: Plain text
#: src/en/documentation/use/guides/secure-email.md:35
#, fuzzy, no-wrap
msgid ""
"Signing\n"
": Signing is a proof that a message has not been manipulated on its way. It guarantees message **integrity** and\n"
"  **authenticity**.\n"
msgstr ""
"Firma\n"
": La firma es una prueba de que un mensaje no ha sido manipulado durante su tránsito. Garantiza la **integridad** y la\n"
"  **autenticidad** del mensaje.\n"

#. type: Plain text
#: src/en/documentation/use/guides/secure-email.md:39
#, fuzzy, no-wrap
msgid ""
"Encryption\n"
": Encryption scrambles a message so that it can only be unscrambled by the intended recipient. It guarantees message\n"
"  **privacy** and **data security**.\n"
msgstr ""
"Cifrado\n"
": El cifrado desordena un mensaje para que solo pueda ser descifrado por el destinatario previsto. Garantiza la\n"
"  **privacidad** y la **seguridad de los datos** del mensaje.\n"

