"      :\"note-public\"=>\"You are writing a |public note|.\",\n"
"      :\"phone-internal\" => \"You are writing an |internal phone note|, only people of your organization will see it.\",\n"
"      :\"phone-public\"=>\"You are writing a |public phone note|.\",\n"
