#. type: Title ##
#: src/en/get-started/get-zammad.md:23
#, no-wrap
msgid "Use Zammad's Hosted Service"
msgstr "Користите Zammad-ов хостинг сервис"

#. type: Plain text
#: src/en/get-started/get-zammad.md:28
#, fuzzy
#| msgid ""
#| "To use Zammad in production, head over to our sister site [zammad.com]"
#| "(https://zammad.com/en/pricing) where you can find prices for Zammad's "
#| "hosted services."
msgid ""
"To use Zammad in production, head over to our sister site [zammad.com]"
