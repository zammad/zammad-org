#: src/en/reference/config-db-server.md:103
#, fuzzy, no-wrap
#| msgid "systemctl restart postgresql zammad\n"
msgid "sudo systemctl restart postgresql zammad\n"
msgstr "systemctl restart postgresql zammad\n"

#. type: Title ##
#: src/en/reference/config-db-server.md:75
#, no-wrap
msgid "Adjust PostgreSQL for bigger instances (optional)"
