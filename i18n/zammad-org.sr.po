msgid "user ID"
msgstr ""

#. type: Bullet: '- '
#: src/en/reference/rest-api/intro.md:319
msgid "user login"
msgstr ""

#. type: Bullet: '- '
#: src/en/reference/rest-api/intro.md:319
msgid "user email"
msgstr ""

#. type: Plain text
#: src/en/reference/rest-api/intro.md:321
msgid "`From` is available for all endpoints."
msgstr ""

