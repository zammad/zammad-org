"\n"
"```sh\n"
"sudo curl -fsSL \"https://go.packager.io/srv/zammad/zammad/stable/installer/ubuntu/24.04.list\" \\\n"
"  -o /etc/apt/sources.list.d/zammad.list\n"
"```\n"
"\n"
