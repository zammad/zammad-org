"sudo SUSEConnect --product PackageHub/$(. /etc/os-release; echo $VERSION_ID)/$(uname -i)\n"
"```\n"
"\n"
"=== CentOS/RHEL\n"
"\n"
"```sh\n"
"sudo yum install wget epel-release\n"
"```\n"
"\n"
