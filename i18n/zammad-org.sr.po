#: src/en/tutorials/connect-config-elasticsearch.md:88
#, no-wrap
msgid ""
"zammad run rails r \"Setting.set('es_attachment_ignore',\\\n"
"[ '.png', '.jpg', '.jpeg', '.mpeg', '.mpg', '.mov', '.bin', '.exe', '.box', '.mbox' ] )\"\n"
msgstr ""

#. type: Plain text
#: src/en/tutorials/connect-config-elasticsearch.md:94
