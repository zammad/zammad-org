# Local development only: keys for the Typesense container of this stack, read
# by `docker compose` in this directory. They are no secrets and protect
# nothing but a local container.
#
# Production never sees this file: the deploy job copies docker-compose.yml
# alone, and the keys of the web host come from CI variables. See README.md.
TYPESENSE_ADMIN_KEY=local-dev-admin-key
TYPESENSE_SEARCH_KEY=local-dev-search-key
