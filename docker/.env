# Local development only: keys for the Typesense container of this stack, read
# by `docker compose` in this directory. They are no secrets and protect
# nothing but a local container.
#
# Keep this file: it is the failsafe for production. docker-compose.yml has no
# defaults for these keys and requires both (`${…:?…}`), so a stack started
# without them, e.g. on a web host whose .env lacks one, refuses to start
# instead of running with the published keys below. Locally, this file sets
# them.
#
# Production never sees this file: the deploy job copies docker-compose.yml
# alone, and the web host has its own .env with its own keys. See README.md.
TYPESENSE_ADMIN_KEY=local-dev-admin-key
TYPESENSE_SEARCH_KEY=local-dev-search-key
